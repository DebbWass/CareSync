{
  "name": "caresync",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npm run start --prefix apps/mobile",
    "android": "npm run android --prefix apps/mobile",
    "ios": "npm run ios --prefix apps/mobile",
    "web": "npm run web --prefix apps/mobile",
    "typecheck": "npm run typecheck --prefix apps/mobile",
    "lint": "npm run lint --prefix apps/mobile",
    "test": "npm run test --prefix apps/mobile",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > apps/mobile/src/types/database.ts",
    "scheduler:run": "node scripts/invoke-scheduler.mjs",
    "verify:realtime": "node scripts/verify-realtime.mjs"
  }
}
